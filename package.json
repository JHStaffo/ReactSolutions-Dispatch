{
  "name": "reactsolutions-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "Non-emergency (non-911) ambulance dispatch prototype: call intake, live multi-dispatcher board, crew scheduler.",
  "main": "app.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:client": "vite --config vite.config.mts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build --config vite.config.mts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "start": "node app.js",
    "package": "npm run build && node scripts/package.cjs",
    "test": "npm run build:server && node --test server/test/api.test.cjs",
    "genkey": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "users": "node scripts/users.cjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
